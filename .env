# Database
POSTGRES_PORT=5432
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}

# RabbitMQ
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@127.0.0.1:${RABBITMQ_PORT}/

# API
API_KEY=test-api
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
API_VERSION=0.1
API_BASE_URL=/api

# Workers
OUTBOX_INTERVAL=1
OUTBOX_BATCH_SIZE=100
RETRY_DELAY_S=1
WEBHOOK_TIMEOUT=10
PUBLISH_TIMEOUT=10
PAYMENT_PROCESSING_MAX_ATTEMPTS=3

# Python
PYTHONPATH=.
